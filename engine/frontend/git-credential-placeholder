#!/bin/sh
# git credential helper for the cell (build plan 5.3; agent-rm-model 4.3 凭据: the agent only ever holds placeholders).
# Answers every `get` with the placeholder pair from a file the deployment puts read-only in the cell files; the
# connector replaces the placeholder with the real credential at the Basic password position (SPEC §3.2 placement 3)
# after the core allowed the request. `store` and `erase` are ignored: nothing real is ever stored in the cell.
# Shell builtins only: a runtime seed need not carry coreutils.
#
# Install (in the runtime seed's global git config, or GIT_CONFIG_GLOBAL):
#     [credential]
#         helper = /w2/bin/git-credential-placeholder
# File format (/w2/placeholders/git, one pair; the username goes out as written, only the password position carries
# the placeholder, e.g. GitHub over HTTPS takes the account's username with a token as the password):
#     username=alice
#     password=W2-PLACEHOLDER-github-alice
set -eu
FILE="${W2_GIT_PLACEHOLDER_FILE:-/w2/placeholders/git}"
drain() { while IFS= read -r _; do :; done; }    # the query (protocol/host) is not needed: one placeholder per cell
case "${1:-}" in
    get)
        drain
        if [ -r "$FILE" ]; then
            while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$FILE"
        fi
        ;;
    store|erase)
        drain
        ;;
esac
exit 0

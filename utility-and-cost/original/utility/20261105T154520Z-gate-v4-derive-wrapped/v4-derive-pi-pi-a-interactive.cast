[13.566052, "o", "\u001b[?2026h\u001b[0m\u001b]8;;\u0007\r\r\n \u001b[38;5;174m\u001b[48;5;67m▀\u001b[0m\u001b[38;5;174m▀█\u001b[0m  \u001b[39m\u001b[2mv1.4.0\u001b[22;39m                                                                                                                                                                                            \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[38;5;67m█▀\u001b[0m \u001b[38;5;179m█\u001b[0m \u001b[39m\u001b[2mescape\u001b[22;39m\u001b[39m\u001b[2m interrupt\u001b[22;39m\u001b[39m\u001b[2m · \u001b[22;39m\u001b[39m\u001b[2mctrl+c/ctrl+d\u001b[22;39m\u001b[39m\u001b[2m clear/exit\u001b[22;39m\u001b[39m\u001b[2m · \u001b[22;39m\u001b[39m\u001b[2m/\u001b[22;39m\u001b[39m\u001b[2m commands\u001b[22;39m\u001b[39m\u001b[2m · \u001b[22;39m\u001b[39m\u001b[2m!\u001b[22;39m\u001b[39m\u001b[2m bash\u001b[22;39m\u001b[39m\u001b[2m · \u001b[22;39m\u001b[39m\u001b[2mctrl+o\u001b[22;39m\u001b[39m\u001b[2m more\u001b[22;39m                                                                                                                   \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[39m\u001b[2mPress ctrl+o to show full startup help and loaded resources.\u001b[22;39m                                                                                                                                           \u001b[0m\u001b]8;;\u0007\r\r\n                                                                                                                                                                                                        \u001b[0m\u001b]8;;\u0007\r\r\n \u001b[39m\u001b[2mPi can explain its own features and look up its docs. Ask it how to use or extend Pi.\u001b[22;39m                                                                                                                  \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b]133;A\u0007\u001b[49m                                                                                                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[49m \u001b[39mWithout using any tools, explain in three sentences what Linux seccomp is.                                                                                                                             \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b]133;B\u0007\u001b]133;C\u0007\u001b[49m                                                                                                                                                                                                        \u001b[49m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b]133;A\u0007\u001b[0m\u001b]8;;\u0007\r\r\n Linux seccomp (secure computing mode) is a kernel feature that restricts which system calls a process is allowed to make. It was originally a strict mode that permitted only a few calls like read,   \u001b[0m\u001b]8;;\u0007\r\r\n write, and exit, but was extended as seccomp-bpf to let a process install a BPF filter that allows, denies, traps, or logs each syscall based on its number and arguments. This lets applications and  \u001b[0m\u001b]8;;\u0007\r\r\n\u001b]133;B\u0007\u001b]133;C\u0007 sandboxes like Docker, Chrome, and systemd reduce their kernel attack surface by blocking everything they don't need.                                                                                  \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[38;5;6m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[7m \u001b[27m                                                                                                                                                                                                       \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[38;5;6m─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"]
[13.566154, "o", "───────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[39m\u001b[2m/work (main)\u001b[22;39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[39m\u001b[2m↑4 ↓165 R2.5k CH99.8% $0.000 0.3%/1.0M (auto)\u001b[22;39m\u001b[39m\u001b[2m                                                                                                                                  claude-haiku-5-5 • medium\u001b[22;39m\u001b[0m\u001b]8;;\u0007\u001b[?2026l\u001b[3A\u001b[1G\u001b[?25l"]

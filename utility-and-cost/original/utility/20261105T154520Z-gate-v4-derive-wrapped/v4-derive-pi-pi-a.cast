[0.00064, "o", "printf 'W2_%s\\n' BEGIN; pi -p 'Without using any tools, explain in three sentences what Linux seccomp is.' --model anthropic/claude-haiku-5-5; s=$?; (exit $s); echo W2_ITEM_EXIT=$?\r\n"]
[0.000721, "o", "W2_BEGIN\r\n"]
[9.967216, "o", "Linux seccomp (secure computing mode) is a kernel feature that restricts which system calls a process is allowed to make. Originally it offered a strict mode that permitted only a few calls like read, write, and exit, but the seccomp-bpf extension lets a process install a BPF filter that allows, denies, traps, or logs each syscall based on its number and arguments. This reduces the kernel attack surface available to a process, which is why sandboxes and container runtimes such as Docker use it.\r\n"]
[9.975099, "o", "W2_ITEM_EXIT=0\r\n"]
[9.975144, "o", "w2$ "]
[9.975324, "o", "exit\r\n"]
[9.975382, "o", "exit\r\n"]

[3.105069, "o", "\u001b[0m$ \u001b[0muv venv /tmp/uvv\r\nUsing CPython 3.12.3 interpreter at: /usr/bin/python3\r\nCreating virtual environment at: /tmp/uvv\r\nActivate with: source /tmp/uvv/bin/activate\r\n\u001b[0m\r\n"]
[3.327724, "o", "\u001b[0m$ \u001b[0mnpm install --prefix /tmp/npm-t is-number\r\nadded 1 package in 274ms\r\n\u001b[0m\r\n"]
[3.890702, "o", "\u001b[0m$ \u001b[0mpython3 -m pip install --target /tmp/pip-t six\r\nCollecting six\r\n  Downloading six-1.17.0-py2.py3-none-any.whl.metadata\r\n     - 1.7 kB 19.7 MB/s 0:00:00\r\nDownloading six-1.17.0-py2.py3-none-any.whl\r\n   - 11.1 kB 125.2 MB/s 0:00:00\r\nInstalling collected packages: six\r\nSuccessfully installed six-1.17.0\r\n\u001b[0m\r\n"]
[4.866818, "o", "\u001b[0m$ \u001b[0muv pip install --python /tmp/uvv/bin/python six\r\nUsing Python 3.12.3 environment at: /tmp/uvv\r\nResolved 1 package in 42ms\r\nPrepared 1 package in 12ms\r\nInstalled 1 package in 3ms\r\n + six==1.17.0\r\n"]
[4.866873, "o", "\u001b[0m\r\n"]

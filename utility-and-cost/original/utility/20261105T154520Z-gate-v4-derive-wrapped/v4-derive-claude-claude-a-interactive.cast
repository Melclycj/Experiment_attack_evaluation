[14.863047, "o", "\u001b[?1049h\u001b[2J\u001b[H\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;5;174m ▐\u001b[48;5;16m▛███▛█\u001b[12G\u001b[39m\u001b[49m\u001b[1mClaude Code\u001b[24G\u001b[22m\u001b[38;5;246mv2.1.312\r\u001b[1B\u001b[38;5;174m▝▜\u001b[48;5;16m█████\u001b[49m█▀\u001b[12G\u001b[38;5;246mHaiku 5.5 · API Usage Billing\r\u001b[1B\u001b[38;5;174m ▝▝   ▝▝ \u001b[12G\u001b[38;5;246m/work\r\u001b[2B\u001b[38;5;174m▎\u001b[3G\u001b[39m\u001b[1mAuto mode is now Claude Code's default permission mode.\r\u001b[1B\u001b[22m\u001b[38;5;174m▎\u001b[3G\u001b[38;5;246mAuto mode lets Claude handle permission prompts automatically. Claude checks each tool call for risky actions and prompt injection before executing, runs the ones it assesses as lower-risk, and \r\u001b[1B\u001b[38;5;174m▎\u001b[3G\u001b[38;5;246mblocks the rest.\r\u001b[1B\u001b[38;5;174m▎\u001b[3G\u001b[38;5;246mhttps://code.claude.com/docs/en/permission-modes\r\u001b[180C\u001b[37B◐ medium · /effort\r\u001b[1B\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m❯ \u001b[7m \r\u001b[1B\u001b[27m\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[38;5;220m⏵⏵ auto mode on\u001b[38;5;246m (shift+tab to cycle) · ← for agents\u001b[39m\u001b[50;1H\u001b[48;3H"]
